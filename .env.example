# Copy to .env and fill in your own values ("npm run setup" creates .env for you).
# .env is gitignored: never commit real tokens.

# Jira Cloud site used by the Jira skills and "npm run jira:after-automation"
JIRA_BASE_URL=https://qatestology.atlassian.net/

# Your own Atlassian login email
JIRA_EMAIL=your.name@example.com

# Your own API token, created at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=paste-your-token-here

# Project key of the tickets you automate
JIRA_PROJECT_KEY=SCRUM
